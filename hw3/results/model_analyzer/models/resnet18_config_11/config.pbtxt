name: "resnet18"
max_batch_size: 16
input {
  name: "IMAGE"
  data_type: TYPE_FP32
  dims: 3
  dims: 224
  dims: 224
}
output {
  name: "LOGITS"
  data_type: TYPE_FP32
  dims: 1000
}
instance_group {
  count: 2
  kind: KIND_GPU
}
dynamic_batching {
  max_queue_delay_microseconds: 1000
}
backend: "python"
